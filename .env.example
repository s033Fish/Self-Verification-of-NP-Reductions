# --- Self-hosted GLM-4.7-Flash on Modal ---------------------------------------
# scripts/deploy_models.sh prints the URL for GlmServer.serve. Append /v1.
GLM_BASE_URL=https://<workspace>--reductions-models-glmserver-serve.modal.run/v1
# Modal proxy token in combined form <token-id>.<token-secret>
# (Modal dashboard -> Settings -> Proxy Auth Tokens).
MODAL_PROXY_TOKEN=wk-xxxxxxxx.ws-xxxxxxxx

# --- Fireworks serverless -----------------------------------------------------
# API key from the Fireworks dashboard.
FIREWORKS_API_KEY=fw_xxxxxxxx
# Exact model ID from the model's Fireworks page.
FIREWORKS_MODEL=accounts/fireworks/models/<model-name>
# Optional; this is the default.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
